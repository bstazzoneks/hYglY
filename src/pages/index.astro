---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>hYglY</title>
    <script is:inline define:vars={{ base }}>
      const preferred = navigator.language?.toLowerCase().startsWith('es') ? 'es' : 'en';
      window.location.replace(`${base}${preferred}/`);
    </script>
  </head>
  <body></body>
</html>
