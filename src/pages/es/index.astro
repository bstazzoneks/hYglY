---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groups } from '../../data/groups';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Inicio"
  description="Base de datos sobre hipoglucemia reactiva postprandial."
  lang="es"
  alternatePath="/"
>
  <section class="hero">
    <h1>Información clara sobre la hipoglucemia reactiva</h1>
    <p>
      Explore las causas según su mecanismo y encuentre recursos para pacientes y profesionales de
      la salud.
    </p>
  </section>
  <div class="emergency" role="alert">
    <strong>
      Si tiene síntomas graves, confusión o pérdida del conocimiento, llame a emergencias.
    </strong>
  </div>
  <section class="audience-actions" aria-label="Elija su perfil">
    <a href={`${base}es/pacientes/`}>Soy paciente</a>
    <a href={`${base}es/medicos/`}>Soy médico</a>
  </section>
  <form class="search-form" action={`${base}es/buscar/`} role="search">
    <label for="site-search-es" class="sr-only">
      Buscar en hYglY
    </label>
    <input id="site-search-es" name="q" type="search" placeholder="Buscar causas o temas" />
    <button type="submit">Buscar</button>
  </form>
  <section aria-labelledby="quick-title">
    <h2 id="quick-title">Acceso rápido</h2>
    <div class="quick-links">
      <a class="card" href={`${base}es/episodio-agudo/`}>
        <strong>Episodio agudo</strong>
      </a>
      <a class="card" href={`${base}es/diagnostico/`}>
        <strong>Cómo se diagnostica</strong>
      </a>
      <a class="card" href={`${base}es/glosario/`}>
        <strong>Glosario</strong>
      </a>
      <a class="card" href={`${base}es/diario/`}>
        <strong>Diario imprimible</strong>
      </a>
    </div>
  </section>
  <section aria-labelledby="causes-title">
    <h2 id="causes-title">Causas por grupo</h2>
    <div class="group-grid">
      {groups.map((group) => (
        <article class="card">
          <h3>
            <a href={`${base}es/causas/${group.id}/`}>{group.es}</a>
          </h3>
          <span class="tag">Postprandial / ayuno / ambas</span>
        </article>
      ))}
    </div>
  </section>
  <p>
    <small>Última actualización del sitio: 17 de noviembre de 2026</small>
  </p>
</BaseLayout>
