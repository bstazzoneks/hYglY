---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { groups } from '../../../data/groups';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Causes"
  description="Groups of causes of reactive hypoglycemia."
  lang="en"
  alternatePath="/causas/"
>
  <h1>Causes of reactive hypoglycemia</h1>
  <div class="group-grid">
    {groups.map((group) => (
      <article class="card">
        <h2>
          <a href={`${base}en/causes/${group.id}/`}>{group.en}</a>
        </h2>
        <span class="tag">Postprandial / fasting / both</span>
      </article>
    ))}
  </div>
</BaseLayout>
