---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  alternatePath?: string;
  dataPagefind?: boolean;
}

const { title, description, lang, alternatePath, dataPagefind = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const selfUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://example.github.io');
const alternateUrl = new URL(
  `${base}${lang === 'es' ? 'en' : 'es'}${alternatePath || '/'}`,
  Astro.site ?? 'https://example.github.io',
);
const esUrl = lang === 'es' ? selfUrl : alternateUrl;
const enUrl = lang === 'en' ? selfUrl : alternateUrl;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0055a4" />
    <meta name="description" content={description} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="canonical" href={selfUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <meta property="og:title" content={`${title} | hYglY`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <title>{title} | hYglY</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="main-content" data-pagefind-body={dataPagefind ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
